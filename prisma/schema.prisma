// Prisma schema for SURDI Map Location application
// Database: MySQL (MariaDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?  @db.Text
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Location {
  id            String   @id @default(cuid())
  provenance    String?  @db.Text
  jalanMasuk    String?  @db.Text
  periode       String?  @db.Text
  lokasi        String?  @db.VarChar(255)
  jenis         String?  @db.VarChar(255)
  media         String?  @db.VarChar(255)
  nomorJumlah   String?  @db.Text
  bagian        String?  @db.VarChar(255)
  pAkuisisi     String?  @db.VarChar(255)
  pPengolahan   String?  @db.VarChar(255)
  pDigitalisasi String?  @db.VarChar(255)
  pRestorasi    String?  @db.VarChar(255)
  noInventaris  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lokasi])
  @@index([jenis])
}
